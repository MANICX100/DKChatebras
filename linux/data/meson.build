desktop_file = 'io.github.dkchatebras.DKChatebras.desktop'
metainfo_file = 'io.github.dkchatebras.DKChatebras.metainfo.xml'

install_data(desktop_file, install_dir: datadir / 'applications')
install_data(metainfo_file, install_dir: datadir / 'metainfo')
install_data(
  'icons/hicolor/scalable/apps/io.github.dkchatebras.DKChatebras.svg',
  install_dir: datadir / 'icons/hicolor/scalable/apps',
)
install_data(
  'icons/hicolor/symbolic/apps/io.github.dkchatebras.DKChatebras-symbolic.svg',
  install_dir: datadir / 'icons/hicolor/symbolic/apps',
)
